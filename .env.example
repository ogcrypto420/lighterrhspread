# ── Telegram ──
# Токен от @BotFather
TG_TOKEN=123456789:AAH...
# Твой chat id (бот пришлёт его в ответ на /start). Можно несколько через запятую.
TG_CHAT_ID=

# Публичный бот: любой может подписаться через /start (false — только TG_CHAT_ID)
ALLOW_PUBLIC=true

# ── Фильтры (значения по умолчанию для новых пользователей) (потом можно менять прямо в Telegram командой /set) ──
# Максимальный спред, % от середины стакана
MAX_SPREAD_PCT=0.003
# Размер твоей заявки в $ — по нему считается проскальзывание
ORDER_SIZE_USD=5000
# Насколько средняя цена исполнения на ORDER_SIZE_USD может уехать от лучшей цены, %
MAX_IMPACT_PCT=0.005
# Глубина: сколько $ должно стоять в полосе ±DEPTH_BAND_PCT от середины на КАЖДОЙ стороне
DEPTH_BAND_PCT=0.02
MIN_DEPTH_USD=5000
# Условие должно держаться N секунд подряд (отсекает моргания стакана)
HOLD_SECONDS=10
# Не чаще одного алерта по одной паре раз в N минут
COOLDOWN_MIN=15
# Слать сообщение, когда пара перестала проходить фильтр (и через сколько секунд)
NOTIFY_LOST=true
LOST_GRACE_SECONDS=10

# ── Биржи ──
# Основной Lighter (Core) мониторится вместе с Lighter RH
ENABLE_CORE=true
# Какие биржи смотрят новые пользователи по умолчанию: rh / core / both
VENUE=both

# ── Какие рынки смотреть ──
# По умолчанию — только акции (перпы). Включи, если нужно ещё:
INCLUDE_ETF=false          # SPY, QQQ, SOXL, USO, SLV, SGOV
INCLUDE_PREIPO=true        # OPENAI, ANTHROPIC, SHEIN
INCLUDE_COMMODITIES=false  # XAU, XAG
INCLUDE_SPOT=false         # спот-пары вида NVDA/USDG
# Только эти тикеры (если пусто — все акции):
SYMBOLS=
# Исключить тикеры:
EXCLUDE=
# Если Lighter залистит что-то, что бот классифицирует неверно — поправь вручную:
EXTRA_STOCKS=
EXTRA_ETF=
EXTRA_PREIPO=
EXTRA_CRYPTO=

# ── Технические ──
API_URL=https://api.rh.lighter.xyz
CORE_API_URL=https://mainnet.zklighter.elliot.ai
CORE_WS_URL=wss://mainnet.zklighter.elliot.ai/stream?readonly=true
WS_URL=wss://api.rh.lighter.xyz/stream?readonly=true
MARKETS_REFRESH_MIN=10
LOG_LEVEL=INFO
